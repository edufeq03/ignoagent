[Unit]
Description=IgnoAgent Infrastructure Health & Security Audit Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/ignoagent
ExecStart=/opt/ignoagent/venv/bin/python -m ignoagent
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/ignoagent/reports /opt/ignoagent/logs /opt/ignoagent/config
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
